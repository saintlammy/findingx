<script define:vars={{ EVENT_DATE_ISO, EVENT_DURATION_MINUTES, NEWSLETTER_ENDPOINT, CONTACT_EMAIL, rotatingWords }}>
  // ---- Countdown ----
  // EVENT_DATE_ISO carries an explicit +01:00 offset, so this resolves to the
  // same instant for every visitor regardless of their own timezone.
  const target = new Date(EVENT_DATE_ISO).getTime();
  const endsAt = target + EVENT_DURATION_MINUTES * 60000;
  const pad = (n) => String(n).padStart(2, '0');
  const cd = {
    dd: document.querySelector('[data-cd="dd"]'),
    hh: document.querySelector('[data-cd="hh"]'),
    mm: document.querySelector('[data-cd="mm"]'),
    ss: document.querySelector('[data-cd="ss"]'),
  };
  const cdLabel = document.getElementById('fx-cd-label');
  const cdGrid = document.getElementById('fx-cd-grid');
  const cdOver = document.getElementById('fx-cd-over');
  let cdTimer = null;

  const tick = () => {
    const now = Date.now();

    // After the event: swap the zeroed clock for a closing message.
    if (now >= endsAt) {
      cdGrid.hidden = true;
      cdLabel.hidden = true;
      cdOver.hidden = false;
      if (cdTimer) clearInterval(cdTimer);
      return;
    }

    // During the event: keep the block, change the framing.
    if (now >= target) cdLabel.textContent = 'HAPPENING NOW IN LEEDS';

    const diff = Math.max(0, target - now);
    cd.dd.textContent = pad(Math.floor(diff / 86400000));
    cd.hh.textContent = pad(Math.floor(diff / 3600000) % 24);
    cd.mm.textContent = pad(Math.floor(diff / 60000) % 60);
    cd.ss.textContent = pad(Math.floor(diff / 1000) % 60);
  };
  tick();
  cdTimer = setInterval(tick, 1000);

  // ---- Mobile menu ----
  const burger = document.getElementById('fxnav-burger');
  const menu = document.getElementById('fx-menu');
  const setMenu = (open) => {
    menu.classList.toggle('open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.textContent = open ? '✕' : '☰';
  };
  burger.addEventListener('click', () => setMenu(!menu.classList.contains('open')));
  menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  window.matchMedia('(max-width: 900px)').addEventListener('change', () => setMenu(false));

  // ---- FAQ accordion (single open) ----
  const faqBtns = [...document.querySelectorAll('[data-faq-btn]')];
  faqBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('[data-faq-item]');
      const answer = btn.nextElementSibling;
      const wasOpen = !answer.hidden;
      faqBtns.forEach((b) => {
        b.nextElementSibling.hidden = true;
        b.setAttribute('aria-expanded', 'false');
        b.querySelector('[data-faq-icon]').textContent = '+';
        b.closest('[data-faq-item]').style.background = '#FFFFFF';
      });
      if (!wasOpen) {
        answer.hidden = false;
        btn.setAttribute('aria-expanded', 'true');
        btn.querySelector('[data-faq-icon]').textContent = '−';
        item.style.background = '#F4F4FA';
      }
    });
  });

  // ---- Newsletter ----
  const form = document.getElementById('fx-newsform');
  const email = document.getElementById('fx-email');
  const errEl = document.getElementById('fx-email-error');
  const submitBtn = form.querySelector('button[type="submit"]');
  const doneEl = document.getElementById('fx-subscribed');

  const showError = (msg) => {
    errEl.textContent = msg;
    errEl.hidden = false;
    form.classList.add('is-invalid');
    email.setAttribute('aria-invalid', 'true');
  };
  const clearError = () => {
    errEl.hidden = true;
    form.classList.remove('is-invalid');
    email.removeAttribute('aria-invalid');
  };
  email.addEventListener('input', clearError);

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearError();

    const value = email.value.trim();
    if (!value || !email.checkValidity()) {
      showError('Enter a valid email address so we can reach you.');
      email.focus();
      return;
    }

    // No provider wired up yet. Say so plainly instead of showing a success
    // state for a subscription that was never recorded anywhere.
    if (!NEWSLETTER_ENDPOINT) {
      showError('Sign-up is not live yet. Email ' + CONTACT_EMAIL + ' and we will add you.');
      return;
    }

    const label = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Adding you...';
    try {
      const res = await fetch(NEWSLETTER_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ email: value }),
      });
      if (!res.ok) throw new Error('Request failed with ' + res.status);
      form.hidden = true;
      doneEl.hidden = false;
    } catch (err) {
      showError('That did not go through. Try again, or email ' + CONTACT_EMAIL + '.');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = label;
    }
  });

  // ---- Motion ----
  // The CSS prefers-reduced-motion rule only reaches CSS animations and
  // transitions. Everything below is JS-driven inline style, so it needs its
  // own guard or it runs regardless of the visitor's OS setting.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  let wordIdx = 0;
  let motionOn = false;
  let wordTimer = null;
  let tickerTween = null;

  const rotWord = document.getElementById('fx-rotword');
  const setWord = (i) => { if (rotWord) rotWord.firstElementChild.textContent = rotatingWords[i]; };

  // The word keeps cycling even when the animation layer is off or GSAP never
  // loads, so the hero's signature moment never depends on a CDN.
  wordTimer = setInterval(() => {
    const advance = () => { wordIdx = (wordIdx + 1) % rotatingWords.length; setWord(wordIdx); };
    if (!rotWord || !motionOn || !window.gsap || document.hidden) return advance();
    window.gsap.to(rotWord, { scale: 0.6, opacity: 0, rotate: 6, duration: 0.22, ease: 'power2.in', onComplete: () => {
      advance();
      window.gsap.fromTo(rotWord, { scale: 1.25, opacity: 0, rotate: -8 }, { scale: 1, opacity: 1, rotate: -2, duration: 0.34, ease: 'back.out(2.2)' });
    }});
  }, 2200);

  // Put every animated element back to its resting design values. Sets those
  // values explicitly rather than using clearProps, which would also strip the
  // inline styles carrying the stamp's fill, border and font size.
  const settleStatic = () => {
    if (tickerTween) { tickerTween.kill(); tickerTween = null; }
    motionOn = false;
    if (!window.gsap) return;
    const h1 = document.getElementById('fx-h1');
    if (h1) gsap.set(h1.children, { x: 0, opacity: 1 });
    if (rotWord) gsap.set(rotWord, { x: 0, opacity: 1, scale: 1, rotate: -2 });
    const badge = document.getElementById('fx-hero-badge');
    if (badge) gsap.set(badge, { x: 0, y: 0, scale: 1, opacity: 1 });
    const ticker = document.getElementById('fx-ticker');
    if (ticker) gsap.set(ticker, { x: 0, xPercent: 0 });
    if (window.ScrollTrigger) ScrollTrigger.getAll().forEach((t) => t.kill());
    gsap.set('[data-reveal]', { y: 0, opacity: 1 });
  };

  let waited = 0;
  let poll = null;
  let started = false;

  // Nothing is ever hidden until a real animation frame has run. rAF only
  // fires when the page can actually paint, so a backgrounded or throttled
  // tab simply keeps the natural markup on screen instead of an empty page.
  const startMotion = () => {
    if (started || !window.gsap || !window.ScrollTrigger) return false;
    if (document.visibilityState !== 'visible') return false;
    started = true;
    requestAnimationFrame(() => requestAnimationFrame(runMotion));
    return true;
  };

  function runMotion() {
    gsap.registerPlugin(window.ScrollTrigger);
    motionOn = true;

    const h1 = document.getElementById('fx-h1');
    if (h1) gsap.fromTo(h1.children, { x: -60, opacity: 0 }, { x: 0, opacity: 1, duration: 0.8, stagger: 0.1, ease: 'power4.out' });
    const badge = document.getElementById('fx-hero-badge');
    if (badge) gsap.fromTo(badge, { y: -320, scale: 0.55, opacity: 0 }, { y: 0, scale: 1, opacity: 1, duration: 1.15, delay: 0.45, ease: 'bounce.out' });
    const ticker = document.getElementById('fx-ticker');
    if (ticker) tickerTween = gsap.to(ticker, { xPercent: -33.34, ease: 'none', duration: 18, repeat: -1 });

    // Reveals move opacity and transform only, so a stalled tween leaves the
    // content readable rather than clipped away.
    gsap.utils.toArray('[data-reveal]').forEach((el) => {
      gsap.fromTo(el, { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 88%' } });
    });

    // Safety net: if anything is still fully transparent after the intro should
    // have finished, put the whole page back to its natural values. Reveals are
    // checked too, not just the hero, since a stalled ScrollTrigger is the more
    // likely way for content to get stranded.
    setTimeout(() => {
      const watched = [h1 && h1.children[0], badge, ...document.querySelectorAll('[data-reveal]')].filter(Boolean);
      const stuck = watched.some((el) => {
        const box = el.getBoundingClientRect();
        const onScreen = box.top < innerHeight && box.bottom > 0;
        return onScreen && parseFloat(getComputedStyle(el).opacity) === 0;
      });
      if (stuck) settleStatic();
    }, 4000);
  }

  const onVisible = () => {
    if (document.visibilityState === 'visible' && startMotion()) {
      document.removeEventListener('visibilitychange', onVisible);
    }
  };

  if (!reduceMotion.matches && !startMotion()) {
    poll = setInterval(() => {
      waited += 150;
      if (startMotion() || waited > 4000) clearInterval(poll);
    }, 150);
    // Backgrounded tab: run the intro when the visitor actually arrives.
    document.addEventListener('visibilitychange', onVisible);
  }

  // Respect the setting being changed after load, in both directions.
  reduceMotion.addEventListener('change', (e) => {
    if (e.matches) { if (poll) clearInterval(poll); settleStatic(); }
    else location.reload();
  });
</script>
</body>
