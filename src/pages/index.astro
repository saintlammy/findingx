---
// Finding X landing page.
// Ported from the Claude Design comp "Finding X - Landing Page.dc.html", which
// carries the Crossing direction into the official BuildersCabal palette.
// The comp's {{ }} bindings are replaced with real data from ../content.
import {
  META,
  SITE_URL,
  EVENT_DATE_ISO,
  EVENT_DURATION_MINUTES,
  EVENT_DATE_LABEL,
  EVENT_TIME_LABEL,
  EVENT_VENUE_LABEL,
  REGISTER_URL,
  NEWSLETTER_ENDPOINT,
  CONTACT_EMAIL,
  PARTNER_EMAIL,
  CONTACT_PHONE,
  navLinks,
  socials,
  rotatingWords,
  longestRotatingWord,
  whyCards,
  speakers,
  speakerBlurb,
  agenda,
  audiences,
  packages,
  faqs,
} from '../content';

// Official BuildersCabal palette (brand guideline, p.6). Kept in one place so
// a colour can never drift between sections.
const C = {
  ink: '#0B0B1A',     // near-black, never pure #000
  blue: '#09099D',    // primary
  orange: '#FF6341',  // secondary
  white: '#FFFFFF',
  paper: '#F4F4FA',   // section tint
  mist: '#EAEAF4',    // map hatch
  chip: '#E8E8F4',    // lowest partner tier
};

const registerHref = REGISTER_URL || '#newsletter';
const registerIsExternal = Boolean(REGISTER_URL);

const canonicalUrl = new URL('/', SITE_URL).href;
const ogImageUrl = new URL('/assets/og.png', SITE_URL).href;

const partnerMailto = `mailto:${PARTNER_EMAIL}?subject=Finding%20X%20Partnership%20Enquiry`;

// Structured data so the event can win its own rich result (PRD §2).
const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: 'Finding X',
  description: META.description,
  startDate: EVENT_DATE_ISO,
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'Place', name: 'Leeds', address: { '@type': 'PostalAddress', addressLocality: 'Leeds', addressCountry: 'GB' } },
  image: [ogImageUrl],
  organizer: { '@type': 'Organization', name: 'BuildersCabal', url: 'https://builderscabal.com' },
};
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{META.title}</title>
<meta name="description" content={META.description}>
<link rel="canonical" href={canonicalUrl}>
<meta property="og:title" content={META.title}>
<meta property="og:description" content={META.description}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonicalUrl}>
<meta property="og:site_name" content="Finding X">
<meta property="og:locale" content="en_GB">
<meta property="og:image" content={ogImageUrl}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Finding X. Living, Working & Building in the UK. 26 September 2026, Leeds.">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={META.title}>
<meta name="twitter:description" content={META.description}>
<meta name="twitter:image" content={ogImageUrl}>
<meta name="theme-color" content={C.blue}>
<link rel="icon" type="image/png" href="/assets/bc-logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
<style is:global define:vars={{ ink: C.ink, blue: C.blue, orange: C.orange, white: C.white, paper: C.paper }}>
html{scroll-behavior:smooth}
body{margin:0;background:var(--white);color:var(--ink);font-family:'DM Sans',sans-serif;-webkit-font-smoothing:antialiased}
a{color:var(--blue)}
a:hover{color:var(--orange)}

@keyframes fx-spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
@keyframes fx-blink{0%,100%{opacity:1}50%{opacity:.35}}

#fxnav-links{display:flex;align-items:center;gap:clamp(10px,2vw,24px)}
#fxnav-burger{display:none}
#fx-hero-grid{grid-template-columns:1fr minmax(280px,390px)}
#fx-hero-aside{border-left:2px solid var(--ink)}
#fx-hero-inner{display:grid;width:100%;grid-template-columns:minmax(min-content,1fr) auto;gap:clamp(24px,4vw,56px);align-items:center}
#fx-rotword{width:fit-content;min-width:0}
/* Invisible sizer holding the longest word, so the stamp reserves its widest
   width up front and does not resize on every rotation. */
#fx-word-sizer{box-sizing:border-box;height:0;padding:0 40px 0 0;border:0;overflow:hidden;visibility:hidden;white-space:nowrap;font-weight:700;font-size:clamp(26px,4.1vw,62px);letter-spacing:-0.035em}
#fx-hero-badge{width:clamp(180px,22vw,320px);height:clamp(180px,22vw,320px);flex-shrink:0}
#fx-hero-badge>svg{animation:fx-spin 16s linear infinite}

.fx-quad{display:grid;gap:18px;grid-template-columns:repeat(4,minmax(0,1fr))}
@media (max-width:1040px){.fx-quad{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:560px){.fx-quad{grid-template-columns:minmax(0,1fr)}}
.fx-trio{display:grid;gap:22px;grid-template-columns:repeat(3,minmax(0,1fr));align-items:stretch}
@media (max-width:1040px){.fx-trio{grid-template-columns:minmax(0,1fr)}}

@media (max-width:900px){
#fxnav-links{display:none}
#fxnav-burger{display:inline-block}
#fx-hero-grid{grid-template-columns:1fr}
#fx-hero-aside{border-left:none;border-top:2px solid var(--ink)}
#fx-hero-inner{grid-template-columns:minmax(0,1fr);gap:8px}
#fx-word-sizer{display:none}
#fx-hero-badge{width:min(58vw,240px);height:min(58vw,240px);margin:26px auto 0}
}
@media (max-width:380px){.fx-nav-cta{font-size:12px !important;padding:9px 14px !important}}

#fx-menu{display:none}
#fx-menu.open{display:flex}

.fx-press{transition:box-shadow .12s,transform .12s}
.fx-press:hover{box-shadow:1px 1px 0 var(--blue) !important;transform:translate(2px,2px)}
.fx-press-ink{transition:box-shadow .12s,transform .12s}
.fx-press-ink:hover{box-shadow:1px 1px 0 var(--ink) !important;transform:translate(3px,3px)}
.fx-card{transition:box-shadow .12s,transform .12s}
.fx-card:hover{box-shadow:2px 2px 0 var(--blue) !important;transform:translate(3px,3px)}
.fx-nl{transition:color .15s}
.fx-nl:hover{color:var(--blue) !important}
.fx-ghost{transition:background .15s,color .15s}
.fx-ghost:hover{background:var(--white);color:var(--blue) !important}
.fx-row{transition:background .15s}
.fx-row:hover{background:var(--blue)}
.fx-chip{transition:background .15s}
.fx-chip:hover{background:var(--orange) !important}
.fx-fl{transition:border-color .15s,color .15s}
.fx-fl:hover{border-color:var(--orange) !important;color:var(--orange) !important}

[data-faq-a][hidden]{display:none}

/* The email input clears its outline, so restore a visible keyboard focus ring. */
#fx-email::placeholder{color:#B9B9C6;opacity:1}
#fx-email:focus-visible{outline:3px solid var(--orange);outline-offset:2px}
#fx-newsform.is-invalid #fx-email{border-color:var(--orange)}
a:focus-visible,button:focus-visible{outline:3px solid var(--orange);outline-offset:3px}

@media (prefers-reduced-motion: reduce){*{animation-duration:.01ms !important;transition-duration:.01ms !important}}
</style>
</head>
<body>

<!-- NAV -->
<nav style={`position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px clamp(16px,4vw,48px);background:${C.white};border-bottom:2px solid ${C.ink}`}>
  <a href="#top" style={`display:flex;align-items:center;gap:10px;text-decoration:none;color:${C.ink}`}>
    <img src="/assets/bc-logo.png" alt="BuildersCabal" width="120" height="66" style="height:20px;width:auto">
    <span style="font-weight:700;font-size:15px;letter-spacing:-0.01em">FINDING<span style={`color:${C.orange}`}>X</span></span>
  </a>
  <div style="display:flex;align-items:center;gap:clamp(10px,2vw,24px)">
    <div id="fxnav-links">
      {navLinks.map((l) => (
        <a href={l.href} class="fx-nl" style={`color:${C.ink};text-decoration:none;font-size:13.5px;font-weight:500`}>{l.label}</a>
      ))}
    </div>
    <a
      href={registerHref}
      data-register
      target={registerIsExternal ? '_blank' : undefined}
      rel={registerIsExternal ? 'noopener' : undefined}
      class="fx-press fx-nav-cta"
      style={`background:${C.orange};color:${C.ink};border:2px solid ${C.ink};text-decoration:none;font-weight:600;font-size:13.5px;padding:10px 20px;box-shadow:3px 3px 0 ${C.blue};white-space:nowrap`}
    >Register Free</a>
    <button id="fxnav-burger" aria-label="Menu" aria-expanded="false" aria-controls="fx-menu" style={`background:${C.white};border:2px solid ${C.ink};cursor:pointer;padding:9px 12px;font-size:15px;line-height:1;color:${C.ink};min-height:44px;min-width:44px;box-shadow:2px 2px 0 ${C.blue}`}>☰</button>
  </div>
  <div id="fx-menu" style={`position:absolute;top:100%;left:0;right:0;background:${C.white};border-bottom:2px solid ${C.ink};flex-direction:column;padding:6px 20px 14px`}>
    {navLinks.map((l, i) => (
      <a href={l.href} data-menu-link style={`color:${C.ink};text-decoration:none;font-size:16px;font-weight:600;padding:15px 2px;${i < navLinks.length - 1 ? 'border-bottom:2px solid rgba(11,11,26,.12)' : ''}`}>{l.label}</a>
    ))}
  </div>
</nav>

<!-- HERO -->
<header id="top" style={`position:relative;overflow:hidden;border-bottom:2px solid ${C.ink}`}>
  <div id="fx-hero-grid" style="display:grid;gap:0;align-items:stretch">
    <div style="padding:clamp(36px,7vh,80px) clamp(16px,4vw,48px);position:relative">
      <div style={`display:inline-block;background:${C.blue};color:${C.white};font-size:11px;font-weight:600;letter-spacing:.16em;padding:7px 14px;margin-bottom:28px`}>A BUILDERSCABAL INITIATIVE</div>
      <div id="fx-hero-inner">
        <div>
          <h1 id="fx-h1" style="margin:0;font-weight:700;font-size:clamp(40px,7vw,104px);line-height:1;letter-spacing:-0.035em">
            <span style="display:block">FINDING</span>
            <span style={`display:block;color:${C.blue}`}>FINDING</span>
            <span style={`display:block;-webkit-text-stroke:2px ${C.ink};color:transparent`}>FINDING</span>
            <span id="fx-rotword" style={`display:flex;align-items:center;justify-content:center;position:relative;box-sizing:border-box;height:1.45em;background:${C.orange};border:2px solid ${C.ink};box-shadow:5px 5px 0 ${C.blue};padding:0 18px;margin-top:16px;transform:rotate(-2deg);font-size:clamp(26px,4.1vw,62px)`}>
              <span style="display:block;line-height:0;white-space:nowrap">{rotatingWords[0]}</span>
            </span>
          </h1>
          <div id="fx-word-sizer" aria-hidden="true">{longestRotatingWord}</div>
          <p style="max-width:520px;font-size:clamp(15px,1.5vw,17px);line-height:1.6;margin:34px 0 0;font-weight:400">You moved for something. Let's find it. Honest lessons from Africans who've figured out living, working &amp; building in the UK.</p>
        </div>
        <div id="fx-hero-badge">
          <svg viewBox="0 0 100 100" style="width:100%;height:100%" aria-hidden="true">
            <defs><path id="fx-circ" d="M 50,50 m -38,0 a 38,38 0 1,1 76,0 a 38,38 0 1,1 -76,0"></path></defs>
            <circle cx="50" cy="50" r="26" fill={C.blue}></circle>
            <text style="font-size:10px;font-weight:600;letter-spacing:2.4px;font-family:'DM Sans',sans-serif" fill={C.ink}><textPath href="#fx-circ">LIVING · WORKING · BUILDING · IN THE UK ·</textPath></text>
            <text x="50" y="58" text-anchor="middle" style="font-size:24px;font-weight:700;font-family:'DM Sans',sans-serif" fill={C.orange}>X</text>
          </svg>
        </div>
      </div>
    </div>

    <aside id="fx-hero-aside" style={`background:${C.blue};color:${C.white};padding:clamp(28px,4vw,44px);display:flex;flex-direction:column;justify-content:space-between;gap:28px`}>
      <div style="display:flex;flex-direction:column;gap:18px">
        <div>
          <div style="font-size:11px;letter-spacing:.18em;opacity:.85;font-weight:500">DATE</div>
          <div style="font-weight:600;font-size:19px">{EVENT_DATE_LABEL}</div>
        </div>
        <div>
          <div style="font-size:11px;letter-spacing:.18em;opacity:.85;font-weight:500">TIME</div>
          <div style="font-weight:600;font-size:19px">{EVENT_TIME_LABEL}</div>
        </div>
        <div>
          <div style="font-size:11px;letter-spacing:.18em;opacity:.85;font-weight:500">VENUE</div>
          <div style="font-weight:600;font-size:19px">{EVENT_VENUE_LABEL}</div>
        </div>
      </div>
      <div>
        <div id="fx-cd-label" style="font-size:11px;letter-spacing:.18em;opacity:.85;font-weight:500;margin-bottom:10px">THE CONVERSATION STARTS IN</div>
        <div id="fx-cd-over" hidden style={`font-weight:600;font-size:17px;line-height:1.45;color:${C.orange}`}>
          Thanks for joining us in Leeds.<br>
          <span style={`font-weight:400;font-size:14px;color:${C.white}`}>Future editions are announced to the list below.</span>
        </div>
        <div id="fx-cd-grid" style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px">
          <div style={`background:${C.ink};padding:11px 6px;text-align:center`}><div data-cd="dd" style={`font-weight:700;font-size:20px;color:${C.orange}`}>00</div><div style="font-size:9px;letter-spacing:.12em;opacity:.8">DAYS</div></div>
          <div style={`background:${C.ink};padding:11px 6px;text-align:center`}><div data-cd="hh" style={`font-weight:700;font-size:20px;color:${C.orange}`}>00</div><div style="font-size:9px;letter-spacing:.12em;opacity:.8">HRS</div></div>
          <div style={`background:${C.ink};padding:11px 6px;text-align:center`}><div data-cd="mm" style={`font-weight:700;font-size:20px;color:${C.orange}`}>00</div><div style="font-size:9px;letter-spacing:.12em;opacity:.8">MIN</div></div>
          <div style={`background:${C.ink};padding:11px 6px;text-align:center`}><div data-cd="ss" style={`font-weight:700;font-size:20px;color:${C.orange};animation:fx-blink 2s infinite`}>00</div><div style="font-size:9px;letter-spacing:.12em;opacity:.8">SEC</div></div>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px;margin-top:22px">
          <a
            href={registerHref}
            data-register
            target={registerIsExternal ? '_blank' : undefined}
            rel={registerIsExternal ? 'noopener' : undefined}
            class="fx-press-ink"
            style={`background:${C.orange};color:${C.ink};border:2px solid ${C.ink};text-decoration:none;text-align:center;font-weight:600;font-size:15px;padding:16px;box-shadow:4px 4px 0 ${C.ink}`}
          >Register Free →</a>
          <a href="#partner" class="fx-ghost" style={`background:transparent;color:${C.white};border:2px solid ${C.white};text-decoration:none;text-align:center;font-weight:600;font-size:15px;padding:16px`}>Partner With Us</a>
        </div>
      </div>
    </aside>
  </div>

  <div style={`overflow:hidden;border-top:2px solid ${C.ink};background:${C.ink};color:${C.white};padding:13px 0;white-space:nowrap`}>
    <div id="fx-ticker" style="display:inline-flex;white-space:nowrap" aria-hidden="true">
      {[0, 1, 2].map(() => (
        <span style="font-weight:500;font-size:15px;letter-spacing:.05em">
          {rotatingWords.map((w) => (
            <>{w} <span style={`color:${C.orange}`}>✕</span> </>
          ))}
        </span>
      ))}
    </div>
  </div>
</header>

<!-- X STATEMENT -->
<section data-reveal style={`padding:clamp(70px,11vh,130px) clamp(16px,4vw,48px);background:${C.blue};color:${C.white};border-bottom:2px solid ${C.ink}`}>
  <div style="max-width:980px;margin:0 auto;text-align:center">
    <p style="font-weight:500;font-size:clamp(19px,2.6vw,32px);line-height:1.45;margin:0">Every year, thousands of us arrive in the UK with degrees, experience, and ambition, searching for something we can't always name.</p>
    <p style="font-weight:500;font-size:clamp(17px,2.2vw,26px);line-height:1.4;margin:28px 0 0;opacity:.8">Opportunity. Community. Direction. Home.</p>
    <p style="font-weight:700;font-size:clamp(24px,3.4vw,44px);line-height:1.25;margin:36px 0 0">We call it <span style={`color:${C.orange}`}>X</span>. This event is about <span style={`background:${C.orange};color:${C.ink};padding:0 12px`}>finding it</span>, faster.</p>
  </div>
</section>

<!-- ABOUT -->
<section id="about" data-reveal style={`padding:clamp(64px,10vh,120px) clamp(16px,4vw,48px);border-bottom:2px solid ${C.ink}`}>
  <div style="max-width:1160px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:clamp(32px,5vw,72px)">
    <div>
      <h2 style="font-weight:700;font-size:clamp(28px,3.6vw,46px);line-height:1.1;letter-spacing:-0.025em;margin:0">Hard work was never the whole equation.</h2>
    </div>
    <div style="font-size:16px;line-height:1.75;display:flex;flex-direction:column;gap:18px">
      <p style="margin:0">You did everything right. Strong career back home. Big plans for the new one. Then you landed, and the network you spent a decade building disappeared overnight. The CV that opened doors now gets silence. The rules changed, and nobody handed you the new playbook.</p>
      <p style="margin:0">Succeeding here isn't about working harder. It's the <mark style={`background:${C.orange};color:${C.ink};padding:0 4px;font-weight:600`}>right mindset</mark>, the <mark style={`background:${C.orange};color:${C.ink};padding:0 4px;font-weight:600`}>right information</mark>, and the <mark style={`background:${C.orange};color:${C.ink};padding:0 4px;font-weight:600`}>right people</mark>. Most of us only find those years in.</p>
      <p style="margin:0;font-weight:600">Finding X exists to close that gap. One room. No motivational fluff, just practical frameworks, honest stories, and lessons that would otherwise cost you years.</p>
    </div>
  </div>
</section>

<!-- WHY ATTEND -->
<section data-reveal style={`padding:clamp(64px,10vh,120px) clamp(16px,4vw,48px);background:${C.paper};border-bottom:2px solid ${C.ink}`}>
  <div style="max-width:1160px;margin:0 auto">
    <h2 style={`font-weight:700;font-size:clamp(28px,3.6vw,46px);letter-spacing:-0.025em;margin:0 0 40px;color:${C.ink}`}>Lessons, not lectures.</h2>
    <div class="fx-quad">
      {whyCards.map((card) => (
        <div class="fx-card" style={`background:${C.white};border:2px solid ${C.ink};box-shadow:5px 5px 0 ${C.blue};padding:26px;display:flex;flex-direction:column;gap:14px`}>
          <div style={`font-weight:700;font-size:26px;color:${C.orange}`}>{card.num}</div>
          <h3 style={`font-weight:600;font-size:17px;margin:0;color:${C.ink}`}>{card.title}</h3>
          <p style={`font-size:14px;line-height:1.65;margin:0;color:${C.ink}`}>{card.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- SPEAKERS -->
<section id="speakers" data-reveal style={`padding:clamp(64px,10vh,120px) clamp(16px,4vw,48px);border-bottom:2px solid ${C.ink}`}>
  <div style="max-width:1160px;margin:0 auto">
    <h2 style="font-weight:700;font-size:clamp(28px,3.6vw,46px);letter-spacing:-0.025em;margin:0 0 14px">Voices worth crossing the city for.</h2>
    <p style="max-width:560px;font-size:15px;line-height:1.65;margin:0 0 40px">{speakerBlurb}</p>
    <div class="fx-quad">
      {speakers.map((s) => (
        <div style={`border:2px solid ${C.ink};background:${C.blue};aspect-ratio:4/5;position:relative;display:flex;flex-direction:column;justify-content:flex-end`}>
          <div style={`position:absolute;top:14px;left:14px;background:${C.orange};border:2px solid ${C.ink};font-size:10px;font-weight:600;letter-spacing:.12em;padding:5px 10px;color:${C.ink}`}>{s.badge}</div>
          <div aria-hidden="true" style="position:absolute;top:40%;left:50%;transform:translate(-50%,-50%) rotate(-6deg);font-weight:700;font-size:68px;color:rgba(255,255,255,.45)">{s.glyph}</div>
          <div style={`background:${C.white};border-top:2px solid ${C.ink};padding:14px 16px`}>
            <div style={`font-weight:600;font-size:14px;color:${C.ink}`}>{s.name}</div>
            <div style={`font-size:12px;opacity:.75;color:${C.ink}`}>{s.role}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- AGENDA -->
<section id="agenda" data-reveal style={`padding:clamp(64px,10vh,120px) clamp(16px,4vw,48px);background:${C.ink};color:${C.white};border-bottom:2px solid ${C.ink}`}>
  <div style="max-width:1000px;margin:0 auto">
    <h2 style="font-weight:700;font-size:clamp(28px,3.6vw,46px);letter-spacing:-0.025em;margin:0 0 40px">One afternoon.<br><span style={`color:${C.orange}`}>Years saved.</span></h2>
    <div style="display:flex;flex-direction:column;border-top:2px solid rgba(255,255,255,.22)">
      {agenda.map((a) => (
        <div class="fx-row" style="display:grid;grid-template-columns:110px 1fr;gap:22px;padding:26px 10px;border-bottom:2px solid rgba(255,255,255,.22);align-items:baseline">
          <div style={`font-weight:600;font-size:14px;color:${C.orange}`}>{a.time}</div>
          <div>
            <h3 style="font-weight:600;font-size:clamp(18px,2vw,23px);margin:0 0 6px">{a.title}</h3>
